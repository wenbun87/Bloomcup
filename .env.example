# Copy to .env (gitignored) and fill in real values.

# Frontend (Vite) -----------------------------------------------------------
# Both must be prefixed with VITE_ to be exposed to the browser.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_xxx           # safe for browser; RLS protects data

# Python scripts (GitHub Actions / local runs) ------------------------------
# Service-role key bypasses RLS — never put it in browser code.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co        # same value as VITE_SUPABASE_URL
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxx              # Supabase → Settings → API Keys → Secret keys
FOOTBALL_DATA_TOKEN=xxxx                             # https://www.football-data.org/client/register
